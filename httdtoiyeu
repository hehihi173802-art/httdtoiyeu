                widget.seekTo(0);
                widget.play();
            }});

            function enableAutoplay() {{
                widget.play();
            }}

            window.addEventListener('click', enableAutoplay, {{ once: true }});
            window.addEventListener('touchstart', enableAutoplay, {{ once: true }});
            window.addEventListener('scroll', enableAutoplay, {{ once: true }});
